						"exec": [
							"// Intentamos leer el cuerpo de la respuesta como JSON\r",
							"let jsonData;\r",
							"try {\r",
							"    jsonData = pm.response.json();\r",
							"} catch (e) {\r",
							"    console.log('La respuesta no es JSON o está vacía', e);\r",
							"}\r",
							"\r",
							"// Si hay token en la respuesta, lo guardamos como variable de colección\r",
							"if (jsonData && jsonData.token) {\r",
							"    pm.collectionVariables.set('token', jsonData.token);\r",
							"    console.log('Token actualizado en la colección');\r",
							"} else {\r",
							"    console.log('No se encontró la propiedad \"token\" en la respuesta');\r",
							"}\r",
